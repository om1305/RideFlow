generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  DRIVER
  ADMIN
}

model User {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String?
  email      String   @unique
  password   String
  role       Role     @default(USER)
  socketId   String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum CaptainStatus{
  OFFLINE
  ONLINE
  ON_RIDE
}

enum VehicleType{
  CAR
  MOTORCYCLE
  AUTO
}

model Captain {
  id String @id @default(uuid())
  firstName String
  lastName String?
  email String @unique
  password String
  socketId String?
  status CaptainStatus @default(OFFLINE)
  vehicleColour String
  vehiclePlate String @unique
  vehicleCapacity Int
  vehicleType VehicleType
  locationLat Float?
  locationLon Float?
  rating Float @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}